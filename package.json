{
  "name": "dsh-workspace-name-wrap",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "author": "MeirinRuan",
  "description": "Wrap long workspace names within the sidebar width. Rows grow with their contents while workspace titles and directory names remain unchanged.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeirinRuan/dsh-workspace-name-wrap.git"
  },
  "homepage": "https://github.com/MeirinRuan/dsh-workspace-name-wrap#readme",
  "bugs": {
    "url": "https://github.com/MeirinRuan/dsh-workspace-name-wrap/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ui"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.2-rc.1"
  },
  "packageManager": "pnpm@11.28.5",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs/*.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
